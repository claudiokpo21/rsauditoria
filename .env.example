# Copiar a .env.development.local (desarrollo) o configurar en el hosting (producción).
# SÓLO claves públicas: la URL del proyecto y la clave PUBLICABLE (sb_publishable_…).
# Nunca coloque aquí la service_role / sb_secret_: la app se niega a arrancar si la detecta.
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_APP_VERSION=1.0.0
